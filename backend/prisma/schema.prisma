// Espejo en Prisma de db/postgresql/001_ingenieria_schema.sql.
// El DDL de ese archivo es la fuente de verdad (se aplica a mano / via
// psql); este schema.prisma se mantiene sincronizado con el. NO correr
// "prisma migrate dev" contra este proyecto todavia (generaria su propio
// historial de migraciones en paralelo al DDL); usar "prisma db pull"
// despues de aplicar el DDL para re-sincronizar si hace falta, o editar
// ambos archivos a mano en paralelo mientras el modulo esta en desarrollo.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["catalogo", "core", "ingenieria"]
}

// =====================================================================
// STUBS de otros modulos
// =====================================================================

model Usuario {
  id            BigInt   @id @default(autoincrement())
  username      String   @unique @db.VarChar(30)
  nombre        String?  @db.VarChar(100)
  passwordHash  String?  @map("password_hash") @db.VarChar(255)
  email         String?  @unique @db.VarChar(255)
  imagenUrl     String?  @map("imagen_url") @db.VarChar(255)
  activo        Boolean  @default(true)
  esSuperadmin  Boolean  @default(false) @map("es_superadmin")
  empresaId     BigInt?  @map("empresa_id")
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz

  empresa  Empresa?               @relation(fields: [empresaId], references: [id])
  permisos UsuarioModuloPermiso[]

  articulosCreados         Articulo[]         @relation("ArticuloCreadoPor")
  maquinasCreadas          Maquina[]          @relation("MaquinaCreadoPor")
  ofsComoVendedor          OrdenFabricacion[] @relation("OfVendedor")
  ofsCreadas               OrdenFabricacion[] @relation("OfCreadoPor")
  otsRevisadas             OrdenTrabajo[]     @relation("OtRevisadoPor")
  otsCreadas               OrdenTrabajo[]     @relation("OtCreadoPor")
  etapasCompletadas        OtEtapa[]          @relation("OtEtapaUsuario")
  tareasCreadas            Tarea[]            @relation("TareaCreadoPor")
  despieceMaquinasCreados  DespieceMaquina[]  @relation("DespieceMaquinaCreadoPor")
  despieceEnsamblesCreados DespieceEnsamble[] @relation("DespieceEnsambleCreadoPor")
  despieceOtCreados        DespieceOt[]       @relation("DespieceOtCreadoPor")
  cambiosComoAnterior      OtCambio[]         @relation("OtCambioUsuarioAnterior")
  cambiosComoNuevo         OtCambio[]         @relation("OtCambioUsuarioNuevo")
  planificacionesCreadas   PlanificacionCorte[] @relation("PlanificacionCreadoPor")

  @@map("usuarios")
  @@schema("core")
}

// Seam minimo de multi-tenancy (ver 003_empresas.sql): solo existe en
// Auth por ahora. Las tablas de negocio (ingenieria/catalogo) NO tienen
// empresa_id todavia -- se agrega cuando haya un segundo tenant real.
model Empresa {
  id     BigInt  @id @default(autoincrement())
  nombre String  @db.VarChar(150)
  activa Boolean @default(true)

  usuarios Usuario[]

  @@map("empresas")
  @@schema("core")
}

enum NivelPermiso {
  SIN_ACCESO
  VER
  EDITAR

  @@map("nivel_permiso")
  @@schema("core")
}

model Modulo {
  id     Int    @id @default(autoincrement())
  clave  String @unique @db.VarChar(30)
  nombre String @db.VarChar(60)

  permisos UsuarioModuloPermiso[]

  @@map("modulos")
  @@schema("core")
}

model UsuarioModuloPermiso {
  usuarioId BigInt       @map("usuario_id")
  moduloId  Int          @map("modulo_id")
  nivel     NivelPermiso @default(SIN_ACCESO)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo  Modulo  @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@id([usuarioId, moduloId])
  @@map("usuario_modulo_permisos")
  @@schema("core")
}

model Cliente {
  id           BigInt @id @default(autoincrement())
  razonSocial  String @map("razon_social") @db.VarChar(255)

  ordenesFabricacion OrdenFabricacion[]

  @@map("clientes")
  @@schema("catalogo")
}

// =====================================================================
// CATALOGOS DEL MODULO
// =====================================================================

model TipoOrden {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(30)

  ordenesFabricacion OrdenFabricacion[]

  @@map("tipos_orden")
  @@schema("ingenieria")
}

model EstadoOf {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(30)

  ordenesFabricacion OrdenFabricacion[]

  @@map("estados_of")
  @@schema("ingenieria")
}

model EstadoOt {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(20)

  ordenesTrabajo OrdenTrabajo[]

  @@map("estados_ot")
  @@schema("ingenieria")
}

model SectorProduccion {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(30)
  orden  Int    @default(0)

  operarios Operario[]
  otEtapas  OtEtapa[]
  tareas    Tarea[]

  @@map("sectores_produccion")
  @@schema("ingenieria")
}

model TipoMaquina {
  id     Int     @id @default(autoincrement())
  codigo String? @db.VarChar(10)
  nombre String  @db.VarChar(60)

  maquinas Maquina[]

  @@map("tipos_maquina")
  @@schema("ingenieria")
}

model TipoCambioBom {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(20)

  otCambios OtCambio[]

  @@map("tipos_cambio_bom")
  @@schema("ingenieria")
}

model Rubro {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(60)

  ordenesFabricacion OrdenFabricacion[]
  maquinasRubros     MaquinaRubro[]

  @@map("rubros")
  @@schema("catalogo")
}

model Categoria {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)

  articulos     Articulo[]
  subcategorias Subcategoria[]

  @@map("categorias")
  @@schema("catalogo")
}

model Subcategoria {
  id          Int    @id @default(autoincrement())
  categoriaId Int    @map("categoria_id")
  nombre      String @db.VarChar(255)

  categoria Categoria  @relation(fields: [categoriaId], references: [id])
  articulos Articulo[]

  @@map("subcategorias")
  @@schema("catalogo")
}

// =====================================================================
// OPERARIOS
// =====================================================================

model Operario {
  id        BigInt  @id @default(autoincrement())
  nombre    String  @db.VarChar(100)
  sectorId  Int?    @map("sector_id")
  activo    Boolean @default(true)
  imagenUrl String? @map("imagen_url") @db.VarChar(255)

  sector             SectorProduccion? @relation(fields: [sectorId], references: [id])
  tareas             Tarea[]
  planificacionCorte PlanificacionCorte[]

  @@map("operarios")
  @@schema("ingenieria")
}

// =====================================================================
// CATALOGO DE ARTICULOS
// =====================================================================

model Articulo {
  id                    BigInt   @id @default(autoincrement())
  nombre                String   @db.VarChar(255)
  categoriaId           Int?     @map("categoria_id")
  subcategoriaId        Int?     @map("subcategoria_id")
  codigoAlbion          String?  @map("codigo_albion") @db.VarChar(150)
  planoPrincipal        String?  @map("plano_principal") @db.VarChar(20)
  denominacionComercial String?  @map("denominacion_comercial") @db.VarChar(120)
  estado                String   @default("Nuevo") @db.VarChar(20)
  descripcion           String?
  creadoPor             BigInt?  @map("creado_por")
  creadoEn              DateTime @default(now()) @map("creado_en") @db.Timestamptz

  categoria    Categoria?    @relation(fields: [categoriaId], references: [id])
  subcategoria Subcategoria? @relation(fields: [subcategoriaId], references: [id])
  creador      Usuario?      @relation("ArticuloCreadoPor", fields: [creadoPor], references: [id])

  despieceMaquinas  DespieceMaquina[]
  despieceEnsambles DespieceEnsamble[]
  despieceOt        DespieceOt[]
  cambiosAnterior   OtCambio[] @relation("OtCambioArticuloAnterior")
  cambiosNuevo      OtCambio[] @relation("OtCambioArticuloNuevo")

  @@map("articulos")
  @@schema("catalogo")
}

// =====================================================================
// MAQUINAS
// =====================================================================

model Maquina {
  id                    BigInt    @id @default(autoincrement())
  planoId               String    @unique @map("plano_id") @db.VarChar(30)
  tipoMaquinaId         Int?      @map("tipo_maquina_id")
  nombre                String    @db.VarChar(255)
  detalle               String?   @db.VarChar(255)
  descripcion           String?
  usos                  String?   @db.VarChar(100)
  tipoHierro            String?   @map("tipo_hierro") @db.VarChar(20)
  anchoMm               Int?      @map("ancho_mm")
  largoMm               Int?      @map("largo_mm")
  altoMm                Int?      @map("alto_mm")
  anchoUtilMm           Int?      @map("ancho_util_mm")
  largoUtilMm           Int?      @map("largo_util_mm")
  diametroMm            Int?      @map("diametro_mm")
  capacidad             Int?
  imagenUrl             String?   @map("imagen_url") @db.VarChar(255)
  pdfUrl                String?   @map("pdf_url") @db.VarChar(255)
  dxfUrl                String?   @map("dxf_url") @db.VarChar(255)
  precioLista           Decimal?  @map("precio_lista") @db.Decimal(14, 2)
  moneda                String?   @db.Char(3)
  valorMateriales       Decimal?  @map("valor_materiales") @db.Decimal(14, 2)
  fechaValorMateriales  DateTime? @map("fecha_valor_materiales") @db.Date
  creadoPor             BigInt?   @map("creado_por")
  creadoEn              DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  tipoMaquina TipoMaquina? @relation(fields: [tipoMaquinaId], references: [id])
  creador     Usuario?     @relation("MaquinaCreadoPor", fields: [creadoPor], references: [id])

  ordenesTrabajo OrdenTrabajo[]
  rubros         MaquinaRubro[]

  @@map("maquinas")
  @@schema("ingenieria")
}

model MaquinaRubro {
  maquinaId BigInt @map("maquina_id")
  rubroId   Int    @map("rubro_id")

  maquina Maquina @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  rubro   Rubro   @relation(fields: [rubroId], references: [id])

  @@id([maquinaId, rubroId])
  @@map("maquinas_rubros")
  @@schema("ingenieria")
}

// =====================================================================
// ORDENES DE FABRICACION (OF) Y ORDENES DE TRABAJO (OT)
// =====================================================================

model OrdenFabricacion {
  id           BigInt    @id @default(autoincrement())
  numeroOf     Int       @unique @map("numero_of")
  tipoOrdenId  Int       @map("tipo_orden_id")
  clienteId    BigInt?   @map("cliente_id")
  fecha        DateTime  @db.Date
  fechaEntrega DateTime? @map("fecha_entrega") @db.Date
  rubroId      Int?      @map("rubro_id")
  referencia   String?   @db.VarChar(50)
  nota         String?
  layoutUrl    String?   @map("layout_url") @db.VarChar(255)
  pautasUrl    String?   @map("pautas_url") @db.VarChar(255)
  vendedorId   BigInt?   @map("vendedor_id")
  estadoId     Int       @map("estado_id")
  creadoPor    BigInt?   @map("creado_por")
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  tipoOrden TipoOrden @relation(fields: [tipoOrdenId], references: [id])
  cliente   Cliente?  @relation(fields: [clienteId], references: [id])
  rubro     Rubro?    @relation(fields: [rubroId], references: [id])
  vendedor  Usuario?  @relation("OfVendedor", fields: [vendedorId], references: [id])
  estado    EstadoOf  @relation(fields: [estadoId], references: [id])
  creador   Usuario?  @relation("OfCreadoPor", fields: [creadoPor], references: [id])

  ordenesTrabajo OrdenTrabajo[]

  @@map("ordenes_fabricacion")
  @@schema("ingenieria")
}

model OrdenTrabajo {
  id               BigInt    @id @default(autoincrement())
  ofId             BigInt    @map("of_id")
  numeroOt         Int       @unique @map("numero_ot")
  maquinaId        BigInt?   @map("maquina_id")
  maquinaNombre    String    @map("maquina_nombre") @db.VarChar(150)
  cantidad         Int       @default(1)
  plano            String?   @db.VarChar(20)
  fecha            DateTime  @db.Date
  fechaEjecucion   DateTime? @map("fecha_ejecucion") @db.Date
  nota             String?
  referencia       String?   @db.VarChar(200)
  observaciones    String?   @db.VarChar(200)
  estadoId         Int?      @map("estado_id")
  revisadoPor      BigInt?   @map("revisado_por")
  placa            String?   @db.VarChar(20)
  serie            String?   @db.VarChar(10)
  motor            String?   @db.VarChar(80)
  fichaTecnicaId   BigInt?   @map("ficha_tecnica_id")
  fichaDocumento   String?   @map("ficha_documento") @db.VarChar(200)
  version          String?   @db.VarChar(8)
  ftd              Int?
  creadoPor        BigInt?   @map("creado_por")
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  ordenFabricacion OrdenFabricacion @relation(fields: [ofId], references: [id], onDelete: Cascade)
  maquina          Maquina?         @relation(fields: [maquinaId], references: [id])
  estado           EstadoOt?        @relation(fields: [estadoId], references: [id])
  revisor          Usuario?         @relation("OtRevisadoPor", fields: [revisadoPor], references: [id])
  creador          Usuario?         @relation("OtCreadoPor", fields: [creadoPor], references: [id])

  etapas             OtEtapa[]
  terceros           OtTercero[]
  imagenes           OtImagen[]
  tareas             Tarea[]
  despieceOt         DespieceOt[]
  cambios            OtCambio[]
  planificacionCorte PlanificacionCorte[]

  @@map("ordenes_trabajo")
  @@schema("ingenieria")
}

model OtEtapa {
  id              BigInt    @id @default(autoincrement())
  otId            BigInt    @map("ot_id")
  sectorId        Int       @map("sector_id")
  completada      Boolean   @default(false)
  fechaCompletada DateTime? @map("fecha_completada") @db.Date
  usuarioId       BigInt?   @map("usuario_id")

  ordenTrabajo OrdenTrabajo     @relation(fields: [otId], references: [id], onDelete: Cascade)
  sector       SectorProduccion @relation(fields: [sectorId], references: [id])
  usuario      Usuario?         @relation("OtEtapaUsuario", fields: [usuarioId], references: [id])

  @@unique([otId, sectorId])
  @@map("ot_etapas")
  @@schema("ingenieria")
}

model OtTercero {
  id            BigInt    @id @default(autoincrement())
  otId          BigInt    @map("ot_id")
  tercero       String    @db.VarChar(60)
  fechaInicio   DateTime? @map("fecha_inicio") @db.Date
  fechaEntrega  DateTime? @map("fecha_entrega") @db.Date

  ordenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)

  @@map("ot_terceros")
  @@schema("ingenieria")
}

model OtImagen {
  id    BigInt @id @default(autoincrement())
  otId  BigInt @map("ot_id")
  url   String @db.VarChar(255)
  orden Int    @default(0)

  ordenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id], onDelete: Cascade)

  @@map("ot_imagenes")
  @@schema("ingenieria")
}

// =====================================================================
// TAREAS
// =====================================================================

model Tarea {
  id                BigInt    @id @default(autoincrement())
  otId              BigInt    @map("ot_id")
  sectorId          Int       @map("sector_id")
  nombreTarea       String    @map("nombre_tarea") @db.VarChar(100)
  fechaInicio       DateTime? @map("fecha_inicio") @db.Date
  fechaTerminacion  DateTime? @map("fecha_terminacion") @db.Date
  operarioId        BigInt?   @map("operario_id")
  creadoPor         BigInt?   @map("creado_por")
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  ordenTrabajo OrdenTrabajo     @relation(fields: [otId], references: [id], onDelete: Cascade)
  sector       SectorProduccion @relation(fields: [sectorId], references: [id])
  operario     Operario?        @relation(fields: [operarioId], references: [id])
  creador      Usuario?         @relation("TareaCreadoPor", fields: [creadoPor], references: [id])

  @@map("tareas")
  @@schema("ingenieria")
}

// =====================================================================
// BOM / DESPIECE (3 tablas separadas por decision de negocio)
// =====================================================================

model DespieceMaquina {
  id                    BigInt   @id @default(autoincrement())
  item                  Int
  plano                 String?  @db.VarChar(30)
  piezaCodigo           String?  @map("pieza_codigo") @db.VarChar(20)
  denominacion          String?  @db.VarChar(130)
  articuloId            BigInt?  @map("articulo_id")
  anchoMm               Int?     @map("ancho_mm")
  largoMm               Int?     @map("largo_mm")
  cantidad              Int
  tipoCorte             String?  @map("tipo_corte") @db.VarChar(10)
  nota                  String?  @db.VarChar(100)
  esChapa               Boolean? @map("es_chapa")
  cantidadComprar       Int?     @map("cantidad_comprar")
  metrosLargoTotal      Int?     @map("metros_largo_total")
  metrosCantidadTotal   Int?     @map("metros_cantidad_total")
  barrasCantidad        Int?     @map("barras_cantidad")
  observacionesCorte    String?  @map("observaciones_corte") @db.VarChar(100)
  esRepuesto            Boolean? @map("es_repuesto")
  verificaStock         Boolean? @map("verifica_stock")
  creadoPor             BigInt?  @map("creado_por")
  creadoEn              DateTime @default(now()) @map("creado_en") @db.Timestamptz

  articulo Articulo? @relation(fields: [articuloId], references: [id])
  creador  Usuario?  @relation("DespieceMaquinaCreadoPor", fields: [creadoPor], references: [id])

  @@map("despiece_maquinas")
  @@schema("ingenieria")
}

model DespieceEnsamble {
  id                    BigInt   @id @default(autoincrement())
  item                  Int
  plano                 String?  @db.VarChar(30)
  piezaCodigo           String?  @map("pieza_codigo") @db.VarChar(20)
  denominacion          String?  @db.VarChar(130)
  articuloId            BigInt?  @map("articulo_id")
  anchoMm               Int?     @map("ancho_mm")
  largoMm               Int?     @map("largo_mm")
  cantidad              Int
  tipoCorte             String?  @map("tipo_corte") @db.VarChar(10)
  nota                  String?  @db.VarChar(100)
  esChapa               Boolean? @map("es_chapa")
  cantidadComprar       Int?     @map("cantidad_comprar")
  metrosLargoTotal      Int?     @map("metros_largo_total")
  metrosCantidadTotal   Int?     @map("metros_cantidad_total")
  barrasCantidad        Int?     @map("barras_cantidad")
  observacionesCorte    String?  @map("observaciones_corte") @db.VarChar(100)
  esRepuesto            Boolean? @map("es_repuesto")
  verificaStock         Boolean? @map("verifica_stock")
  creadoPor             BigInt?  @map("creado_por")
  creadoEn              DateTime @default(now()) @map("creado_en") @db.Timestamptz

  articulo Articulo? @relation(fields: [articuloId], references: [id])
  creador  Usuario?  @relation("DespieceEnsambleCreadoPor", fields: [creadoPor], references: [id])

  @@map("despiece_ensambles")
  @@schema("ingenieria")
}

model DespieceOt {
  id                    BigInt    @id @default(autoincrement())
  item                  Int
  plano                 String?   @db.VarChar(30)
  piezaCodigo           String?   @map("pieza_codigo") @db.VarChar(20)
  denominacion          String?   @db.VarChar(130)
  articuloId            BigInt?   @map("articulo_id")
  anchoMm               Int?      @map("ancho_mm")
  largoMm               Int?      @map("largo_mm")
  cantidad              Int
  tipoCorte             String?   @map("tipo_corte") @db.VarChar(10)
  nota                  String?   @db.VarChar(100)
  esChapa               Boolean?  @map("es_chapa")
  cantidadComprar       Int?      @map("cantidad_comprar")
  metrosLargoTotal      Int?      @map("metros_largo_total")
  metrosCantidadTotal   Int?      @map("metros_cantidad_total")
  barrasCantidad        Int?      @map("barras_cantidad")
  observacionesCorte    String?   @map("observaciones_corte") @db.VarChar(100)
  esRepuesto            Boolean?  @map("es_repuesto")
  verificaStock         Boolean?  @map("verifica_stock")
  creadoPor             BigInt?   @map("creado_por")
  creadoEn              DateTime  @default(now()) @map("creado_en") @db.Timestamptz
  otId                  BigInt    @map("ot_id")
  planificacionId       BigInt?   @map("planificacion_id")
  fechaCorteFinalizado  DateTime? @map("fecha_corte_finalizado") @db.Timestamptz
  operacion             String?   @db.VarChar(10)

  articulo     Articulo?           @relation(fields: [articuloId], references: [id])
  creador      Usuario?            @relation("DespieceOtCreadoPor", fields: [creadoPor], references: [id])
  ordenTrabajo OrdenTrabajo        @relation(fields: [otId], references: [id], onDelete: Cascade)
  planificacion PlanificacionCorte? @relation(fields: [planificacionId], references: [id])

  planificacionItems PlanificacionCorteItem[]

  @@map("despiece_ot")
  @@schema("ingenieria")
}

// =====================================================================
// BITACORA DE CAMBIOS DEL DESPIECE
// =====================================================================

model OtCambio {
  id                  BigInt   @id @default(autoincrement())
  otId                BigInt?  @map("ot_id")
  fecha               DateTime @default(now()) @db.Timestamptz
  plano               String?  @db.VarChar(30)
  piezaCodigo         String?  @map("pieza_codigo") @db.VarChar(30)
  denominacion        String?  @db.VarChar(50)
  tipoCambioId        Int      @map("tipo_cambio_id")
  articuloAnteriorId  BigInt?  @map("articulo_anterior_id")
  anchoAnteriorMm     Int?     @map("ancho_anterior_mm")
  largoAnteriorMm     Int?     @map("largo_anterior_mm")
  cantidadAnterior    Int?     @map("cantidad_anterior")
  usuarioAnteriorId   BigInt?  @map("usuario_anterior_id")
  articuloNuevoId     BigInt?  @map("articulo_nuevo_id")
  anchoNuevoMm        Int?     @map("ancho_nuevo_mm")
  largoNuevoMm        Int?     @map("largo_nuevo_mm")
  cantidadNuevo       Int?     @map("cantidad_nuevo")
  usuarioNuevoId      BigInt?  @map("usuario_nuevo_id")

  ordenTrabajo      OrdenTrabajo?  @relation(fields: [otId], references: [id])
  tipoCambio        TipoCambioBom  @relation(fields: [tipoCambioId], references: [id])
  articuloAnterior  Articulo?      @relation("OtCambioArticuloAnterior", fields: [articuloAnteriorId], references: [id])
  usuarioAnterior   Usuario?       @relation("OtCambioUsuarioAnterior", fields: [usuarioAnteriorId], references: [id])
  articuloNuevo     Articulo?      @relation("OtCambioArticuloNuevo", fields: [articuloNuevoId], references: [id])
  usuarioNuevo      Usuario?       @relation("OtCambioUsuarioNuevo", fields: [usuarioNuevoId], references: [id])

  @@map("ot_cambios")
  @@schema("ingenieria")
}

// =====================================================================
// PLANIFICACION DE CORTE
// =====================================================================

model PlanificacionCorte {
  id            BigInt   @id @default(autoincrement())
  otId          BigInt   @map("ot_id")
  fechaInicio   DateTime @map("fecha_inicio") @db.Date
  fechaEntrega  DateTime @map("fecha_entrega") @db.Date
  operarioId    BigInt?  @map("operario_id")
  nota          String?  @db.VarChar(250)
  creadoPor     BigInt?  @map("creado_por")
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz

  ordenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id])
  operario     Operario?    @relation(fields: [operarioId], references: [id])
  creador      Usuario?     @relation("PlanificacionCreadoPor", fields: [creadoPor], references: [id])

  despieceOt DespieceOt[]
  items      PlanificacionCorteItem[]

  @@map("planificacion_corte")
  @@schema("ingenieria")
}

model PlanificacionCorteItem {
  planificacionId BigInt @map("planificacion_id")
  despieceOtId    BigInt @map("despiece_ot_id")

  planificacion PlanificacionCorte @relation(fields: [planificacionId], references: [id], onDelete: Cascade)
  despieceOt    DespieceOt         @relation(fields: [despieceOtId], references: [id], onDelete: Cascade)

  @@id([planificacionId, despieceOtId])
  @@map("planificacion_corte_items")
  @@schema("ingenieria")
}
