# Origen: MySQL LOCAL con el dump backup_desarrollo2013.sql ya importado.
# Nunca apuntar esto a un servidor de produccion o remoto.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=desarrollo2013

# Destino: PostgreSQL local/desarrollo donde vive el schema ingenieria
# (ver db/postgresql/001_ingenieria_schema.sql, debe estar aplicado antes de migrar).
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=albion_erp

# Cantidad de filas por sentencia INSERT batched (subir/bajar segun memoria disponible).
BATCH_SIZE=500

# Offsets CONFIRMADOS en el codigo fuente PHP legacy (COPIA_OF/), no son
# una inferencia: of_listar.php linea 264 y maquina_convertir_clon.php
# linea 145. No deberian necesitar cambiarse.
OF_NUMERO_OFFSET=3000
OT_NUMERO_OFFSET=5000
